{
  "name": "watabou-city-generator-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "build": "bash scripts/build.sh",
    "baseline": "bash scripts/baseline.sh",
    "start": "node scripts/serve.mjs --open",
    "test": "npm run baseline && node scripts/smoke-test.mjs",
    "test:identity": "node scripts/smoke-test.mjs --identity-only",
    "test:roofs": "node scripts/smoke-test.mjs --roofs-only",
    "test:quality": "node scripts/smoke-test.mjs --quality-only",
    "test:prototype": "node scripts/smoke-test.mjs --prototype-only",
    "test:frontage": "node scripts/smoke-test.mjs --frontage-only",
    "test:mix": "node scripts/smoke-test.mjs --mix-only"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "lucide-static": "0.468.0",
    "playwright": "1.56.1",
    "pngjs": "7.0.0"
  },
  "dependencies": {
    "polygon-clipping": "0.15.7",
    "polylabel": "2.0.1"
  }
}
